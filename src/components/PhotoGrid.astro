---
import { Image } from 'astro:assets';
import { humanize, type Photo } from '../lib/photos';

interface Props {
  photos: Photo[];
  showCaptions?: boolean;
}

const { photos, showCaptions = false } = Astro.props;
---

{
  photos.length === 0 ? (
    <p class="text-muted">
      No photos yet — add some to <code>src/assets/photos/</code> and they'll
      show up here.
    </p>
  ) : (
    <>
      <div class="photo-grid">
        {photos.map((photo, i) => (
          <figure class="photo-grid__item">
            <button type="button" data-open={i} aria-label={`View photo: ${humanize(photo.fileName) || 'Yuzu'}`}>
              <Image
                src={photo.image}
                alt=""
                width={480}
                height={480}
                format="webp"
                loading={i < 6 ? 'eager' : 'lazy'}
              />
            </button>
            {showCaptions && humanize(photo.fileName) && (
              <figcaption>{humanize(photo.fileName)}</figcaption>
            )}
          </figure>
        ))}
      </div>

      <dialog class="lightbox" id="lightbox">
        <button type="button" class="lightbox__close" data-close aria-label="Close">
          ✕
        </button>
        {photos.map((photo, i) => (
          <Image
            src={photo.image}
            alt={humanize(photo.fileName) || 'Photo of Yuzu'}
            width={1400}
            format="webp"
            class="lightbox__img"
            data-slide={i}
            hidden={i !== 0}
          />
        ))}
      </dialog>

      <script>
        const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
        if (dialog) {
          const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-open]');
          const slides = dialog.querySelectorAll<HTMLElement>('[data-slide]');

          openButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
              const idx = btn.getAttribute('data-open');
              slides.forEach((slide) => {
                slide.hidden = slide.getAttribute('data-slide') !== idx;
              });
              dialog.showModal();
            });
          });

          dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
        }
      </script>
    </>
  )
}

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.25rem;
  }

  .photo-grid__item {
    margin: 0;
  }

  .photo-grid__item button {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .photo-grid__item :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 0.75rem;
    transition: transform 0.2s ease;
  }

  .photo-grid__item button:hover :global(img) {
    transform: scale(1.03);
  }

  .photo-grid__item figcaption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .lightbox {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    background: transparent;
    max-width: min(90vw, 1000px);
    max-height: 90vh;
  }

  .lightbox::backdrop {
    background: rgba(63, 47, 36, 0.8);
  }

  .lightbox :global(.lightbox__img) {
    max-width: min(90vw, 1000px);
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius);
  }

  .lightbox__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(0, 0, 0, 0.55);
    color: white;
    border: none;
    border-radius: 999px;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 1;
  }
</style>
