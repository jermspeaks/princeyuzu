---
import BaseLayout from '../layouts/BaseLayout.astro';
import { guestbookEntries } from '../data/guestbook';

// 1. Create a free account at https://formspree.io
// 2. Create a new form, and copy the form ID from the endpoint it gives you
//    (looks like https://formspree.io/f/abcdwxyz — the ID is the last part)
// 3. Paste it in below, replacing YOUR_FORM_ID.
// See the README for the full walkthrough, including how to display past
// messages (src/data/guestbook.ts).
const FORM_ID: string = 'mjyvyygd';
const isPlaceholder = FORM_ID === 'YOUR_FORM_ID';
---

<BaseLayout title="Guestbook">
  <section class="section">
    <div class="container container--narrow">
      <h1>Guestbook</h1>
      <p class="text-muted">
        If you knew Yuzu, leave a note — a memory, a photo you took of him, or
        just a hello.
      </p>

      {
        isPlaceholder && (
          <p class="card notice">
            ⚠️ The guestbook form isn't wired up yet. This message will only
            show on the deployed site until a real Formspree form ID replaces{' '}
            <code>YOUR_FORM_ID</code> in <code>src/pages/guestbook.astro</code>{' '}
            — see the README for setup steps.
          </p>
        )
      }

      <div data-fs-success />
      <div data-fs-error />

      <form id="guestbook-form" class="card" data-form-id={FORM_ID}>
        <label for="name">Your name</label>
        <input type="text" id="name" name="name" data-fs-field required maxlength="80" />
        <span data-fs-error="name" />

        <label for="message">Your message</label>
        <textarea id="message" name="message" data-fs-field required rows="4" maxlength="1000" />
        <span data-fs-error="message" />

        <!-- honeypot field to deter simple spam bots -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

        <button type="submit" data-fs-submit-btn class="button">Sign the guestbook</button>
      </form>
    </div>
  </section>

  {
    guestbookEntries.length > 0 && (
      <section class="section section--alt">
        <div class="container container--narrow">
          <h2>Messages from friends</h2>
          <ul class="guestbook-entries">
            {guestbookEntries.map((entry) => (
              <li class="card guestbook-entry">
                <p class="guestbook-entry__message">“{entry.message}”</p>
                <p class="guestbook-entry__meta text-muted">
                  — {entry.name}
                  {entry.date && `, ${entry.date}`}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import { initForm } from '@formspree/ajax';

  const form = document.querySelector<HTMLFormElement>('#guestbook-form');
  const formId = form?.dataset.formId;

  if (form && formId && formId !== 'YOUR_FORM_ID') {
    // Resets the form on success by default; no onSuccess override needed.
    initForm({
      formElement: form,
      formId,
      useDefaultStyles: false,
    });
  }
</script>

<style>
  .container--narrow {
    max-width: 640px;
  }

  .notice {
    border-color: var(--color-accent);
    background: #fff3e6;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 2rem;
  }

  form label {
    font-weight: 600;
    margin-top: 0.85rem;
  }

  form label:first-child {
    margin-top: 0;
  }

  input,
  textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: white;
    color: var(--color-text);
  }

  button[type='submit'] {
    margin-top: 1.25rem;
    align-self: flex-start;
  }

  /* Formspree AJAX state styling (useDefaultStyles: false above) */
  [data-fs-error],
  [data-fs-success] {
    display: none;
  }

  [data-fs-success][data-fs-active] {
    display: block;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    background: #ecf6ec;
    border: 1px solid #bfe0bf;
    color: #2f5d34;
    font-weight: 600;
  }

  [data-fs-error=''][data-fs-active] {
    display: block;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    background: #fbeaea;
    border: 1px solid #efb8b8;
    color: #8a2c2c;
    font-weight: 600;
  }

  [data-fs-error]:not([data-fs-error=''])[data-fs-active] {
    display: block;
    color: #c0392b;
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }

  [data-fs-field][aria-invalid='true'] {
    border-color: #c0392b;
  }

  .guestbook-entries {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .guestbook-entry__message {
    font-style: italic;
    margin-bottom: 0.5rem;
  }

  .guestbook-entry__meta {
    margin: 0;
    font-weight: 600;
  }
</style>
